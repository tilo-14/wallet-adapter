{
    "name": "@solana/wallet-adapter-react-light",
    "version": "0.1.0",
    "author": "Solana Maintainers <maintainers@solana.foundation>",
    "repository": "https://github.com/anza-xyz/wallet-adapter",
    "license": "Apache-2.0",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "lib",
        "src",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        "require": "./lib/cjs/index.js",
        "import": "./lib/esm/index.js",
        "types": "./lib/types/index.d.ts"
    },
    "scripts": {
        "build": "tsc --build --verbose && pnpm run package",
        "clean": "shx mkdir -p lib && shx rm -rf lib",
        "lint": "prettier --check 'src/{*,**/*}.{ts,tsx,js,jsx,json}' && eslint",
        "package": "shx mkdir -p lib/cjs && shx echo '{ \"type\": \"commonjs\" }' > lib/cjs/package.json",
        "test": "jest",
        "test:e2e": "jest --testMatch='**/__tests__/e2e-*.test.ts' --runInBand"
    },
    "peerDependencies": {
        "@solana/web3.js": "^1.98.0",
        "react": "*"
    },
    "dependencies": {
        "@lightprotocol/compressed-token": "beta",
        "@lightprotocol/stateless.js": "beta",
        "@solana/wallet-adapter-base": "workspace:^",
        "@solana/wallet-adapter-react": "workspace:^"
    },
    "devDependencies": {
        "@solana/web3.js": "^1.98.2",
        "@types/bn.js": "^5.1.6",
        "@types/jest": "^29.5.14",
        "@types/react": "^19.1.6",
        "bn.js": "^5.2.1",
        "jest": "^29.7.0",
        "react": "^19.1.0",
        "shx": "^0.4.0",
        "ts-jest": "^29.3.4"
    }
}
